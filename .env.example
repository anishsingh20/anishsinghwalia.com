# Public site origin used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://anishsinghwalia.com

# Contact form. SMTP is the mail path. Gmail: smtp.gmail.com, port 587, an app password.
CONTACT_TO=waliaanish1997@gmail.com
CONTACT_FROM=waliaanish1997@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to mock to accept the form without sending. Leave unset once SMTP_* is filled in.
# CONTACT_TRANSPORT=mock

# Ask bot. OpenAI-compatible. DigitalOcean Serverless Inference:
# https://inference.do-ai.run/v1
# Leave LLM_API_KEY empty to use the built-in notes fallback.
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_API_KEY=
LLM_MODEL=llama3.3-70b-instruct
