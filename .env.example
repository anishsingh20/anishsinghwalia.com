# Copy this file to .env.local (npm run setup does it). Everything runs with no keys.

# Public site origin used for canonical URLs, sitemap, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://anishsinghwalia.com

# Contact form. SMTP is the mail path. Gmail: smtp.gmail.com, port 587, an app password.
CONTACT_TO=waliaanish1997@gmail.com
CONTACT_FROM=waliaanish1997@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to mock to accept the form without sending. Leave unset once SMTP_* is filled in.
# CONTACT_TRANSPORT=mock

# Ask bot, the model. Any OpenAI-compatible endpoint with tool calling.
# Default is DigitalOcean Serverless Inference. Empty LLM_API_KEY = keyless mode
# (live Medium RSS, GitHub API, DigitalOcean author page, plus the notes in knowledge/).
LLM_BASE_URL=https://inference.do-ai.run/v1
LLM_API_KEY=
LLM_MODEL=llama3.3-70b-instruct

# Ask bot, web search. Optional. Set one key and the bot picks that provider.
# SEARCH_PROVIDER forces one when several keys are set: tavily | brave | serper | exa
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
EXA_API_KEY=
# SEARCH_PROVIDER=tavily

# Optional. Raises the GitHub API rate limit for the live GitHub tool.
GITHUB_TOKEN=
